<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Official NuGet.org feed - supports all public packages -->
    <add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  
  <!-- Disable all credential providers to avoid auth errors -->
  <disabledPackageSources>
    <!-- Remove private/internal feeds if they were previously configured -->
  </disabledPackageSources>
  
  <!-- Trust the official NuGet feed -->
  <packageRestore>
    <add key="automatic" value="true" />
    <add key="enabled" value="true" />
  </packageRestore>
</configuration>
