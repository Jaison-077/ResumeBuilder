{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200;https://resumebuilder.com"
  },
  "AzureOpenAI": {
    "Endpoint": "https://<your-resource-name>.openai.azure.com/",
    "Key": "<your-openai-api-key>",
    "DeploymentName": "gpt-4-turbo",
    "ApiVersion": "2024-02-15-preview"
  },
  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=<account-name>;AccountKey=<account-key>;EndpointSuffix=core.windows.net",
    "ContainerName": "resumes"
  },
  "Database": {
    "ConnectionString": "Server=<server>;Database=ResumeBuilder;User Id=<user>;Password=<password>;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"
  }
}
